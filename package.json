{
  "name": "@galaxy-stack/orbit-observability",
  "version": "0.1.10",
  "description": "Observability for Orbit - OpenTelemetry tracing, Prometheus metrics, structured logging",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --packages external",
    "build:types": "bash scripts/build-types.sh",
    "clean": "rm -rf dist",
    "changeset": "changeset"
  },
  "dependencies": {
    "@galaxy-stack/orbit-core": "^0.2.0",
    "@galaxy-stack/orbit-common": "^0.1.13"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "@changesets/cli": "^2.27.0"
  },
  "author": "Orbit Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxy-orbit/orbit-observability.git"
  },
  "bugs": {
    "url": "https://github.com/galaxy-orbit/orbit-cli/issues"
  },
  "homepage": "https://galaxy-orbit-framework.vercel.app"
}
